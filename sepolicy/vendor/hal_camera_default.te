type vendor_bufcon_device, dev_type, file_type;

allow hal_camera_default app_efs_file:dir search;
allow hal_camera_default app_efs_file:file r_file_perms;
allow hal_camera_default camera_vendor_data_file:dir search;
allow hal_camera_default camera_vendor_data_file:file rw_file_perms;
allow hal_camera_default dmabuf_heap_device:chr_file rw_file_perms;
allow hal_camera_default efs_file:dir search;
allow hal_camera_default hal_graphics_composer_default:fd use;
allow hal_camera_default hal_graphics_mapper_hwservice:hwservice_manager find;
allow hal_camera_default proc_meminfo:file r_file_perms;
allow hal_camera_default sysfs_camera_writable:file rw_file_perms;
allow hal_camera_default vendor_bufcon_device:chr_file { open read write ioctl };
allow hal_camera_default hal_vendor_epic_hwservice:hwservice_manager find;

binder_call(hal_camera_default, hal_vendor_epic_service_default);
binder_call(hal_camera_default, system_server);
binder_call(system_server, hal_camera_default);

get_prop(hal_camera_default, exported_camera_prop);

r_dir_file(hal_camera_default, sysfs_camera);
r_dir_file(hal_camera_default, sysfs_battery);

set_prop(hal_camera_default, vendor_camera_prop);

vndbinder_use(hal_camera_default);

dontaudit hal_camera_default default_prop:file { getattr map open read };
