allow init boot_block_device:lnk_file relabelto;
allow init efs_file:dir mounton;
allow init epicd_socket:unix_stream_socket { create bind };
allow init epicd_socket:unix_dgram_socket { create bind };
allow init k250a_device:chr_file { create setattr unlink };
allow init kernel:system module_request;
allow init mnt_vendor_file:dir mounton;
allow init servicemanager:binder { call transfer };
allow init socket_device:sock_file { create setattr unlink };
allow init st21nfc_device:chr_file { ioctl open read write };
allow init sysfs_block_writable:file rw_file_perms;
allow init tmpfs:lnk_file create;
allow init vendor_file:dir mounton;
allow init vendor_firmware_file:file mounton;

dontaudit init sysfs:dir add_name;
dontaudit init sysfs:file create;
dontaudit init sysfs_dm:dir add_name;
dontaudit init sysfs_fs_f2fs:dir add_name;
dontaudit init system_file:dir relabelfrom;
dontaudit init system_file:file relabelfrom;
dontaudit init system_file:sock_file { getattr relabelfrom };
dontaudit init system_lib_file:dir relabelfrom;
dontaudit init system_lib_file:file relabelfrom;
