allow untrusted_app hal_drm_widevine_service:service_manager find;

dontaudit untrusted_app apex_info_file:file getattr;
dontaudit untrusted_app ashmem_device:chr_file open;
dontaudit untrusted_app block_device:dir search;
dontaudit untrusted_app debugfs_trace_marker:file getattr;
dontaudit untrusted_app efs_file:dir getattr;
dontaudit untrusted_app fuse_device:chr_file getattr;
dontaudit untrusted_app linkerconfig_file:dir getattr;
dontaudit untrusted_app media_rw_data_file:file relabelfrom;
dontaudit untrusted_app metadata_file:dir getattr;
dontaudit untrusted_app mirror_data_file:dir getattr;
dontaudit untrusted_app mnt_vendor_file:dir search;
dontaudit untrusted_app proc:file read;
dontaudit untrusted_app proc_filesystems:file read;
dontaudit untrusted_app proc_modules:file getattr;
dontaudit untrusted_app proc_pid_max:file read;
dontaudit untrusted_app proc_tty_drivers:file read;
dontaudit untrusted_app proc_version:file read;
dontaudit untrusted_app qemu_hw_prop:file read;
dontaudit untrusted_app qemu_sf_lcd_density_prop:file read;
dontaudit untrusted_app selinuxfs:file read;
dontaudit untrusted_app serialno_prop:file read;
dontaudit untrusted_app untrusted_app:netlink_route_socket { bind nlmsg_readpriv };
dontaudit untrusted_app user_profile_data_file:dir getattr;
dontaudit untrusted_app vendor_firmware_file:dir search;
