allow vendor_init cgroup:file getattr;
allow vendor_init cpdebug_efs_file:lnk_file { getattr setattr };
allow vendor_init functionfs:file getattr;
allow vendor_init pdp_efs_file:file getattr;
allow vendor_init proc_hung_task:file write;
allow vendor_init proc_sched:file rw_file_perms;
allow vendor_init proc_swappiness:file rw_file_perms;
allow vendor_init proc_watermark_scale_factor:file w_file_perms;
allow vendor_init tmpfs:dir { write add_name };
allow vendor_init tmpfs:lnk_file create;

get_prop(vendor_init, vendor_radio_prop);

set_prop(vendor_init, vendor_hwc_prop)
set_prop(vendor_init, vendor_cbd_prop)

dontaudit vendor_init bluetooth_prop:property_service set;
dontaudit vendor_init proc:dir add_name;
dontaudit vendor_init proc:file create;
dontaudit vendor_init sysfs:dir add_name;
dontaudit vendor_init sysfs:file create;
dontaudit vendor_init sysfs_devices_system_cpu:dir { add_name create };
dontaudit vendor_init sysfs_devices_system_cpu:file create;
dontaudit vendor_init sysfs_sensors:dir { add_name create };
dontaudit vendor_init sysfs_sensors:file create;
dontaudit vendor_init sysfs_transparent_hugepage:file create;
dontaudit vendor_init sysfs_transparent_hugepage:dir add_name;
dontaudit vendor_init { default_prop system_prop build_prop }:property_service set;
dontaudit vendor_init { radio_prop system_prop }:file read;
