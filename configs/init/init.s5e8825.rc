    chmod 0644 /efs/cpk/redata.bin
    chmod 0644 /efs/h2k.dat
    chmod 0644 /efs/cpk/h2k.dat

    # MST
    chown system system /sys/class/mstldo/mst_drv/transmit
    chown system system /sys/class/mstldo/mst_drv/mfc
